+def _alt_symbol(ticker: str):
+    """BRK-B(야후 등에서 흔한 표기) vs BRK.B(토스 등 다른 데이터소스에서
+    쓰는 표기)처럼, 복수클래스 주식은 구분자가 하이픈/마침표로 데이터
